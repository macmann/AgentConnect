NODE_ENV=development
# Local development only; production requires true.
REQUIRE_EMAIL_VERIFICATION=false
PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
DATABASE_URL=postgres://agentconnect:LOCAL_GENERATED_PASSWORD@localhost:5432/agentconnect
REDIS_URL=redis://localhost:6379
MASTER_KEY=GENERATE_32_RANDOM_BYTES_AS_64_HEX_CHARACTERS
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=agentconnect
S3_SECRET_KEY=LOCAL_GENERATED_PASSWORD
S3_BUCKET=agentconnect
TEMPORAL_ADDRESS=localhost:7233
MAIL_FROM=noreply@agentconnect.local
SMTP_URL=smtp://127.0.0.1:1025
# For production use a secure external SMTP provider
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Exact approved provider hostnames; no wildcard endpoints.
MODEL_ALLOWED_HOSTS=api.openai.com,api.anthropic.com,generativelanguage.googleapis.com
# Empty by default. Explicit host:port exceptions for trusted private model servers.
MODEL_PRIVATE_HOSTS=

# Website crawl destinations are opt-in and also need cloud egress approval.
KNOWLEDGE_ALLOWED_HOSTS=
KNOWLEDGE_PRIVATE_HOSTS=

# Tools are opt-in. Exact HTTP hosts, private host:port exceptions and DB host:port grants.
TOOL_ALLOWED_HOSTS=
TOOL_PRIVATE_HOSTS=
TOOL_DATABASE_HOSTS=

# Enterprise source endpoints: exact HTTPS hostnames and explicit trusted private host:port exceptions.
CONNECTOR_ALLOWED_HOSTS=
CONNECTOR_PRIVATE_HOSTS=
