{
  "name": "agentconnect",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @agentconnect/api test",
    "db:migrate": "pnpm --filter @agentconnect/api db:migrate",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "local:init": "node scripts/local-init.mjs",
    "storage:init": "pnpm --filter @agentconnect/api storage:init",
    "format": "prettier --write .",
    "test:e2e": "node --env-file=.env node_modules/@playwright/test/cli.js test",
    "deployment:check": "pnpm --filter @agentconnect/api deployment:check",
    "test:security": "pnpm --filter @agentconnect/api test:security",
    "recovery:drill": "pnpm --filter @agentconnect/api recovery:drill",
    "build:widget-markdown": "node scripts/build-widget-markdown.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.10.0",
    "esbuild": "^0.28.2",
    "eslint": "10.12.0",
    "marked": "^18.1.3",
    "postgres": "^3.4.9",
    "prettier": "^3.8.1",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "turbo": "2.11.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}
