{
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "NEXT_PUBLIC_API_URL"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@agentconnect/schemas#build": {
      "outputs": []
    },
    "@agentconnect/db#build": {
      "outputs": []
    },
    "@agentconnect/provider-sdk#build": {
      "outputs": []
    },
    "@agentconnect/agent-sdk#build": {
      "outputs": []
    },
    "@agentconnect/rag#build": {
      "outputs": []
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "MASTER_KEY",
    "WEB_ORIGIN",
    "PORT",
    "S3_ENDPOINT",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "S3_BUCKET",
    "TEMPORAL_ADDRESS",
    "SMTP_URL",
    "MAIL_FROM",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTEL_RESOURCE_ATTRIBUTES",
    "NODE_ENV",
    "NEXT_PUBLIC_API_URL",
    "MODEL_ALLOWED_HOSTS",
    "MODEL_PRIVATE_HOSTS",
    "KNOWLEDGE_ALLOWED_HOSTS",
    "KNOWLEDGE_PRIVATE_HOSTS",
    "CONNECTOR_ALLOWED_HOSTS",
    "CONNECTOR_PRIVATE_HOSTS",
    "MONITORING_TOKEN",
    "WORKER_HEALTH_HOST",
    "WORKER_HEALTH_PORT",
    "WORKER_STALL_SECONDS"
  ]
}
