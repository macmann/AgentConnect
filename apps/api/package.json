{
  "name": "@agentconnect/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=../../.env src/migrate.ts",
    "test": "tsx --env-file=../../.env --test --test-concurrency=1 test/*.test.ts",
    "storage:init": "tsx --env-file=../../.env src/init-storage.ts",
    "mail:inspect": "tsx --env-file=../../.env src/local-mail.ts",
    "mail:worker": "tsx --env-file=../../.env src/mail-worker.ts",
    "start": "node --env-file=../../.env dist/server.js"
  },
  "dependencies": {
    "@agentconnect/agent-sdk": "workspace:*",
    "@agentconnect/db": "workspace:*",
    "@agentconnect/provider-sdk": "workspace:*",
    "@agentconnect/schemas": "workspace:*",
    "@aws-sdk/client-s3": "^3.1000.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "^9.7.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.71.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@temporalio/client": "1.24.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "ioredis": "^5.8.2",
    "nodemailer": "^7.0.12",
    "postgres": "^3.4.8",
    "undici": "^7.30.0",
    "zod": "4.6.5",
    "@agentconnect/rag": "workspace:*",
    "@fastify/multipart": "^9.4.0",
    "cheerio": "^1.2.0",
    "fflate": "^0.8.2",
    "fast-xml-parser": "^5.3.8",
    "csv-parse": "^6.1.0",
    "pdfjs-dist": "^5.4.624",
    "csv-stringify": "^6.6.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^7.0.11"
  },
  "exports": {
    "./mail": "./src/mail.ts",
    "./config": "./src/config.ts",
    "./ingestion": "./src/ingestion.ts"
  }
}
